<a class="skip" href="#main">Skip to content</a>
<header class="bar">
  <span class="brand">Bioquest</span>
  <nav aria-label="Main">
    <button class="tab" data-tab="home">Home</button>
    <button class="tab" data-tab="game">Build-A-Biotech</button>
    <button class="tab" data-tab="map">Map of Opportunities</button>
  </nav>
</header>
<main id="main">
<section id="home">
  <div class="hero">
    <h1>Bioquest</h1>
    <p>Discover your path in biotechnology through interactive exploration and local opportunity tracking</p>
