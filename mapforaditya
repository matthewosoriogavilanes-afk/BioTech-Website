  </div>
  <div class="wrap" id="nav" tabindex="-1">
    <h2>Choose your path</h2>
    <div class="cards">
      <article class="card">
        <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M24 6h16M28 6v18L12 54a4 4 0 0 0 4 6h32a4 4 0 0 0 4-6L36 24V6" fill="#e0f2fe" stroke="#0f172a" stroke-width="3" stroke-linejoin="round"/><path d="M18 44h28" stroke="#38bdf8" stroke-width="6"/></svg>
        <h3>Build-A-Biotech Startup</h3>
        <p>Run a biotech facility, build your dream team and make scenario choices to uncover your biotech profile.</p>
        <button class="btn" data-tab="game">Play the game</button>
      </article>
      <article class="card">
        <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 60C18 42 12 34 12 24a20 20 0 0 1 40 0c0 10-6 18-20 36z" fill="#38bdf8" stroke="#0f172a" stroke-width="3"/><circle cx="32" cy="24" r="7" fill="#fff" stroke="#0f172a" stroke-width="3"/></svg>
        <h3>Map of Opportunities</h3>
        <p>Explore New Jersey internships, programs and jobs by county, type and biotech sector.</p>
        <button class="btn" data-tab="map">Open the map</button>
      </article>
    </div>
  </div>
</section>

<section id="game" hidden class="wrap">
  <h2>Build-A-Biotech Startup</h2>
  <div id="stage" class="stage th-hub" tabindex="-1" aria-live="polite"></div>
</section>

<section id="map" hidden class="wrap">
  <h2>Map of Opportunities</h2>
  <div class="maplay">
    <aside aria-label="Filters">
      <fieldset><legend>Opportunity Type</legend><div id="f-type"></div></fieldset>
      <fieldset><legend>Sector</legend><div id="f-sector"></div></fieldset>
      <fieldset><legend>County</legend><div id="f-county" class="cty"></div></fieldset>
      <button class="btn alt" id="clear">Clear filters</button>
      <p id="status" role="status" class="note"></p>
    </aside>
    <svg id="nj" viewBox="0 0 500 949" role="group" aria-label="Map of New Jersey counties with opportunity pins"></svg>
  </div>
</section>
</main>

