/* map */
.maplay{display:grid;grid-template-columns:260px 1fr;gap:1.5rem}
fieldset{border:2px solid var(--navy);border-radius:12px;margin:0 0 1rem;padding:.6rem .9rem}
legend{font-weight:700;padding:0 .4rem}
fieldset label{display:block;font-size:.95rem}
.cty{max-height:200px;overflow:auto}
#nj{width:100%;max-height:78vh;background:#f8fafc;border:2px solid var(--navy);border-radius:16px}
.c{fill:#e2e8f0;stroke:var(--navy);stroke-width:1.2;stroke-linejoin:round}.c:hover{fill:#bae6fd}.c.on{fill:var(--sky)}
.pin{cursor:pointer}.pin:focus-visible path{stroke:var(--navy);stroke-width:3}
.cl{font:700 9px Lato,sans-serif;fill:var(--navy);pointer-events:none;paint-order:stroke;stroke:#fff;stroke-width:2px;text-anchor:middle}
@media(max-width:760px){.cards,.maplay{grid-template-columns:1fr}.scene{flex-direction:column;align-items:flex-start}.bubble:before{display:none}.spr{width:80px}.roles{gap:.35rem}.role{font-size:.7rem;padding:.4rem .2rem;min-height:66px}.world{aspect-ratio:1/1}.bldg{left:12%;width:76%}.pct{grid-template-columns:1fr 1fr 40px}.floor{grid-template-columns:30px 1fr 1fr}.room{font-size:.8rem;min-height:84px}.stage{padding:.7rem}}
@media(prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
</style>
</head>
